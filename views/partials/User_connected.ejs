<% 
	style = new Intl.DateTimeFormat("fr-FR", {year:"numeric", month:"long", weekday:"long", day:"numeric"});
	dt = new Date();
	date = style.format(dt)
%>
<div class="user-connected">
    <p>
        <span class="user-connected-info"><%= date %></span>
    </p> 
    <p>
        Utilisateur: <span class="user-connected-info"><%= session.name %></span>
    </p>
    <p>
        Email: <span class="user-connected-info"><%= session.email %></span>
    </p>
</div>