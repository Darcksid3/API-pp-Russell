<div class="errmess">
    <% if (typeof session.errorMessage !== 'undefined') { %>
        <p><%= session.errorMessage %></p>
    <% } else {} %>
</div>
<form method="post" action="/users" id="Form_add_users">
    <fieldset>
        <legend>Inscription</legend>
        <div class="form-contnair">
            <div class="form-row">
                <div class="border-input">
                    <input type="text" name="name" id="name" placeholder="Le nom ?" value="<%= //session.formData.name ? session.formData.name : '' %>" required />
                </div>
            </div>
            <div class="form-row">
                <div class="border-input">
                    <input type="email" name="email" id="email" placeholder="L'email ?" value="<%= //session.formData.email  ? session.formData.email : '' %> " required />
                </div>
            </div>
            <!-- section password -->
            <div class="form-column">
                <div class="form-row">
                    <div class="border-input">
                        <input type="password" name="password" id="create_password" placeholder="Le mot de passe ?" required />
                    </div>
                    <img src="images/oeil.png" style="width: 20px; height: 20px;" alt="afficher le champ" onclick="afficheMdp('create_password')">
                </div>
                <div class="info-password">
                    <small>
                        Le mot de passe doit faire 10 et 20 caractères, contenir au moins 1minuscule 1 majuscule
                    </small>
                    <small>
                        1 chiffre et 1 symbole parmis les suivants : <b>&~#{}()|\^@=+$%!/:.;?,</b>
                    </small>
                </div>
                <div class="form-row">
                    <p class="btn-submit" onclick="randomMdpGen('create_password')">
                        Généré un mot de passe
                    </p>
                </div>
            </div>
            <div class="form-row">
                <button type="submit" class="btn-submit">Ajouter</button>
            </div>
        </div>
    </fieldset>
</form>
<script>
    const btnSubmit = document.querySelector('button[type="submit"]');
    const errElement = document.querySelector('.errmess p');
    btnSubmit.addEventListener('click', function(event) {
        errElement.textContent = '';
    });
    console.log(FormData)
</script>