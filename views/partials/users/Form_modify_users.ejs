
<% if (typeof user !== 'undefined') { %> 
    <table class="table"> 
        <tr> 
            <td>Nom</td>
            <td>Email</td>
        </tr> 
        <tr> 
            <td><%= user ? user.name : '' %></td> 
            <td><%= user ? user.email : '' %></td> 
        </tr> 
    </table> 
<% } else { %> 
    <p style="color: red; font-weight: bold;">Aucun utilisateur trouvée.</p> 
    <% } %> 
    <form method="post" action="/users/<%= user ? user.email : '' %>" id="Form-modify-user"> 
        <fieldset> 
            <legend>Modification d'un utilisateur</legend> 
            <div class="form-contnair">
                <div class="form-row">
                    <div class="form-column">
                        <label for="name">Nom:</label>
                    </div>
                    <div class="form-column">
                        <div class="border-input">
                            <input type="text" name="name" id="name" value="<%= user ? user.name : '' %>" required />
                        </div>
                    </div>
                </div>
            <div class="form-row">
                <div class="form-column">
                    <label for="email">Email:</label>
                </div>
                <div class="form-column">
                    <div class="border-input">
                        <input type="email" name="email" id="email" value="<%= user ? user.email : '' %>" required />
                    </div>
                </div>
            </div>
            <div class="form-column">
                <div class="form-row">
                    <div class="form-column">
                        <label for="password">Mot de passe:</label>
                    </div>
                    <div class="form-column">
                        <div class="form-row">
                            <div class="border-input">
                                <input type="password" name="password" id="create_password" />
                            </div>
                            <img src="../../../images/oeil.png" style="width: 20px; height: 20px;" alt="afficher le champ" onclick="afficheMdp('create_password')">
                        </div>
                    </div>
                </div>
                <div class="info-password">
                    <small>
                        Le mot de passe doit faire 10 et 20 caractères, contenir au moins 1minuscule 1 majuscule
                    </small>
                    <small>
                        1 chiffre et 1 symbole parmis les suivants : <b>&~#{}()|\^@=+$%!/:.;?,</b>
                    </small>
                </div>
                <div class="form-row">
                    <p class="btn-submit" onclick="randomMdpGen('create_password')">Généré un mot de passe</p>
                </div>
            </div>
            <div class="form-row ">
                <button type="submit" id="modify" class="btn-submit">Modifier et Enregistrer</button>
                <button form="Form-delete-user" type="submit" id="delete" class="btn-delete">Supprimer</button>
            </div>
            </div>
        </fieldset>
    </form>
    <form method="POST" action="/users/<%= user ? user.email : '' %>" id="Form-delete-user">
    </form>
    <script src="/javascripts/user_modify_form.js"></script>



